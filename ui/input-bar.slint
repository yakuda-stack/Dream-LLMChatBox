import { Button, CheckBox, ComboBox, Palette, Slider } from "std-widgets.slint";
import { SharedFolder } from "types.slint";
import { Spot } from "hint.slint";

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <color> active-color: #cf222e;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: root.active ? root.active-color : touch.has-hover && root.enabled ? Palette.alternate-background : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.active ? white : Palette.foreground;
        stroke-width: 2px;
        fill: transparent;
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    callback clicked();

    height: 44px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.alternate-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font-weight: 600;
        }

        Text {
            text: root.hint;
            font-size: 11px;
            opacity: 0.6;
        }
    }
}

component LevelMeter inherits Rectangle {
    in property <float> level;

    height: 10px;
    border-radius: 5px;
    background: Palette.border;
    clip: true;

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.level, 0, 1);
        height: parent.height;
        background: root.level > 0.9 ? #cf222e : root.level > 0.7 ? #bf8700 : #2ea043;
        animate width { duration: 60ms; }
    }
}

component SyncChip inherits Rectangle {
    in property <bool> on;
    callback clicked();

    height: 26px;
    width: label.preferred-width + 20px;
    border-radius: 13px;
    background: root.on ? #2da44e40 : Palette.alternate-background;
    border-width: 1px;
    border-color: root.on ? #2da44e : Palette.border;

    label := Text {
        text: root.on ? @tr("🔄 Sync before each message: on") : @tr("🔄 Sync before each message: off");
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
        opacity: touch.has-hover || root.on ? 1.0 : 0.75;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FolderChip inherits Rectangle {
    in property <string> name;
    in property <string> path;
    in property <bool> writable;
    callback toggle-write();
    callback remove();

    height: 26px;
    width: row.preferred-width;
    border-radius: 13px;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: root.writable ? #d4a72c : Palette.border;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;

        Text {
            text: "📁 " + root.name;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            max-width: 200px;
        }

        Rectangle {
            width: mode.preferred-width + 12px;
            height: 18px;
            y: 4px;
            border-radius: 9px;
            background: root.writable ? #d4a72c40 : Palette.control-background;

            mode := Text {
                text: root.writable ? @tr("read + write") : @tr("read only");
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: switch.has-hover ? 1.0 : 0.75;
            }

            switch := TouchArea {
                clicked => { root.toggle-write(); }
            }
        }

        Rectangle {
            width: 20px;

            close := TouchArea {
                clicked => { root.remove(); }
            }

            Text {
                text: "×";
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: close.has-hover ? 1.0 : 0.6;
            }
        }
    }
}

component AttachmentChip inherits Rectangle {
    in property <string> text;
    callback remove();

    height: 26px;
    width: row.preferred-width;
    border-radius: 13px;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 4px;

        Text {
            text: root.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            max-width: 240px;
        }

        Rectangle {
            width: 20px;

            close := TouchArea {
                clicked => { root.remove(); }
            }

            Text {
                text: "×";
                horizontal-alignment: center;
                vertical-alignment: center;
                opacity: close.has-hover ? 1.0 : 0.6;
            }
        }
    }
}

export component InputBar inherits VerticalLayout {
    in property <[string]> models;
    in-out property <string> selected-model;
    in property <bool> busy;
    in property <string> usage-text;
    in property <float> context-used;
    in property <string> context-label;
    in property <bool> show-context-bar;
    in-out property <string> draft;
    in property <[string]> pending-attachments;
    in property <[SharedFolder]> shared-folders;
    in property <bool> sync-available;
    in-out property <bool> auto-sync;
    callback auto-sync-changed(bool);
    in property <bool> mic-recording;
    in-out property <int> think-mode: 0;
    callback think-changed(int);
    in property <bool> mic-busy;
    in property <string> mic-status;
    in property <float> mic-level;
    in-out property <bool> mic-panel-open;
    in property <[string]> mic-devices;
    in-out property <int> mic-device-index;
    in property <[string]> mic-languages;
    in-out property <int> mic-language-index;
    in property <[string]> speech-models;
    in-out property <int> speech-model-index;
    in-out property <float> mic-gain;
    in-out property <bool> mic-live;
    callback mic-live-changed(bool);
    in property <string> kill-command;
    callback send(string);
    callback stop();
    callback compact-chat();
    callback kill-in-terminal();
    callback refresh-models();
    callback model-selected(string);
    callback attach-files();
    callback paste-clipboard() -> bool;
    callback attach-folder();
    callback attach-media();
    callback remove-attachment(int);
    callback share-folder();
    callback test-env();
    callback remove-shared-folder(int);
    callback toggle-folder-write(int);
    callback mic-toggle();
    callback mic-panel(bool);
    callback mic-device-selected(int);
    callback mic-language-selected(int);
    callback speech-model-selected(int);
    callback mic-gain-changed(float);

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 28px;
    spacing: 6px;
    vertical-stretch: 0;

    function submit() {
        if (!root.busy && (root.draft != "" || root.pending-attachments.length > 0)) {
            root.send(root.draft);
            root.draft = "";
        }
    }

    if root.mic-panel-open: Rectangle {
        border-radius: 12px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.background;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 10px;

                Text {
                    text: @tr("Microphone level");
                    font-weight: 600;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    LevelMeter {
                        level: root.mic-level;
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: @tr("Microphone");
                        font-size: 11px;
                        opacity: 0.7;
                    }

                    ComboBox {
                        model: root.mic-devices;
                        current-index <=> root.mic-device-index;
                        enabled: !root.mic-recording;
                        selected => { root.mic-device-selected(self.current-index); }
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: @tr("Language");
                        font-size: 11px;
                        opacity: 0.7;
                    }

                    ComboBox {
                        model: root.mic-languages;
                        current-index <=> root.mic-language-index;
                        selected => { root.mic-language-selected(self.current-index); }
                    }
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: @tr("Speech model");
                        font-size: 11px;
                        opacity: 0.7;
                    }

                    ComboBox {
                        model: root.speech-models;
                        current-index <=> root.speech-model-index;
                        enabled: !root.mic-busy;
                        selected => { root.speech-model-selected(self.current-index); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Text {
                    text: @tr("Gain");
                    vertical-alignment: center;
                }

                Slider {
                    minimum: 0.2;
                    maximum: 4.0;
                    value <=> root.mic-gain;
                    released => { root.mic-gain-changed(self.value); }
                }

                Text {
                    width: 44px;
                    text: round(root.mic-gain * 10) / 10 + "×";
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }

            CheckBox {
                text: @tr("Live text while speaking (shows the words as you talk)");
                checked <=> root.mic-live;
                toggled => { root.mic-live-changed(self.checked); }
            }
        }
    }

    Rectangle {
        border-radius: 16px;
        border-width: 1px;
        border-color: input.has-focus ? Palette.accent-background : Palette.border;
        background: Palette.control-background;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            if root.shared-folders.length > 0: HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for folder[index] in root.shared-folders: FolderChip {
                    name: folder.name;
                    path: folder.path;
                    writable: folder.writable;
                    toggle-write => { root.toggle-folder-write(index); }
                    remove => { root.remove-shared-folder(index); }
                }

                if root.sync-available: SyncChip {
                    on: root.auto-sync;
                    clicked => {
                        root.auto-sync = !root.auto-sync;
                        root.auto-sync-changed(root.auto-sync);
                    }
                }
            }

            if root.pending-attachments.length > 0: HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for name[index] in root.pending-attachments: AttachmentChip {
                    text: name;
                    remove => { root.remove-attachment(index); }
                }
            }

            Rectangle {
                preferred-width: 0px;
                min-width: 0px;
                height: min(max(input.preferred-height, 24px), 170px);

                TouchArea {
                    scroll-event(event) => {
                        flick.content-y = max(min(0px, flick.height - flick.content-height), min(0px, flick.content-y + event.delta-y));
                        return accept;
                    }
                }

                flick := Flickable {
                    content-height: max(input.preferred-height, self.height);
                    interactive: false;

                    input := TextInput {
                        x: 0;
                        y: 0;
                        width: flick.width;
                        height: max(self.preferred-height, flick.height);
                        single-line: false;
                        wrap: word-wrap;
                        text <=> root.draft;
                        enabled: root.models.length > 0;
                        color: Palette.control-foreground;
                        vertical-alignment: center;
                        edited => {
                            flick.content-y = min(0px, flick.height - flick.content-height);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Return && !event.modifiers.shift) {
                                root.submit();
                                return accept;
                            }
                            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                                if (root.paste-clipboard()) {
                                    return accept;
                                }
                            }
                            return reject;
                        }
                    }
                }

                if root.draft == "": Text {
                    width: parent.width;
                    text: root.mic-recording ? @tr("Listening… click the microphone again to stop") : @tr("Write a message…");
                    vertical-alignment: center;
                    opacity: 0.5;
                }
            }

            HorizontalLayout {
                spacing: 6px;

                Spot {
                    name: "attach";

                    IconButton {
                        icon: "M12 5v14 M5 12h14";
                        clicked => { attach-menu.show(); }
                    }
                }

                Spot {
                    name: "mic";

                    IconButton {
                        icon: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z M5 11a7 7 0 0 0 14 0 M12 18v3";
                        active: root.mic-recording;
                        enabled: !root.mic-busy;
                        clicked => { root.mic-toggle(); }
                    }
                }

                Spot {
                    name: "mic-settings";

                    IconButton {
                        icon: root.mic-panel-open ? "M6 9l6 6 6-6" : "M6 15l6-6 6 6";
                        active: root.mic-panel-open;
                        active-color: Palette.accent-background;
                        clicked => {
                            root.mic-panel-open = !root.mic-panel-open;
                            root.mic-panel(root.mic-panel-open);
                        }
                    }
                }

                Spot {
                    name: "think";

                    think-button := IconButton {
                        icon: root.think-mode == 2 ? "M9 18h6 M10 21h4 M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z M4 4l16 16" : "M9 18h6 M10 21h4 M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z";
                        active: root.think-mode == 1;
                        active-color: Palette.accent-background;
                        clicked => {
                            root.think-mode = mod(root.think-mode + 1, 3);
                            root.think-changed(root.think-mode);
                        }

                        if root.think-mode == 0: Rectangle {
                            x: parent.width - 13px;
                            y: parent.height - 13px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: Palette.accent-background;

                            Text {
                                text: "A";
                                font-size: 8px;
                                font-weight: 700;
                                color: Palette.accent-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 6px;
                }

                Spot {
                    name: "model";

                    ComboBox {
                        width: 240px;
                        model: root.models;
                        current-value <=> root.selected-model;
                        enabled: !root.busy && root.models.length > 0;
                        selected(value) => { root.model-selected(value); }
                    }
                }

                Button {
                    text: @tr("Refresh");
                    enabled: !root.busy;
                    clicked => { root.refresh-models(); }
                }

                Rectangle { }

                Rectangle {
                    width: send-button.preferred-width;

                    Spot {
                        name: "send";

                        send-button := Button {
                            text: root.busy ? @tr("Stop") : @tr("Send");
                            primary: !root.busy;
                            enabled: root.busy || root.models.length > 0;
                            clicked => {
                                if (root.busy) {
                                    root.stop();
                                } else {
                                    root.submit();
                                }
                            }
                        }
                    }

                    if root.busy: TouchArea {
                        clicked => { root.stop(); }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                stop-menu.show();
                            }
                        }
                    }
                }
            }
        }

        kill-text := TextInput {
            width: 0px;
            height: 0px;
            opacity: 0;
            read-only: true;
            text: root.kill-command;
        }

        stop-menu := PopupWindow {
            x: parent.width - 300px;
            y: -self.height - 4px;
            width: 300px;

            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;

                VerticalLayout {
                    padding: 6px;

                    MenuItem {
                        text: @tr("Copy kill command");
                        hint: root.kill-command;
                        clicked => {
                            kill-text.select-all();
                            kill-text.copy();
                            kill-text.clear-selection();
                            stop-menu.close();
                        }
                    }

                    MenuItem {
                        text: @tr("Run kill command in a terminal");
                        hint: @tr("Ends the model process if Stop hangs");
                        clicked => {
                            root.kill-in-terminal();
                            stop-menu.close();
                        }
                    }
                }
            }
        }

        attach-menu := PopupWindow {
            x: 8px;
            y: -self.height - 4px;
            width: 260px;

            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;

                VerticalLayout {
                    padding: 6px;

                    MenuItem {
                        text: @tr("Add files");
                        hint: @tr("Text, code, PDF or images");
                        clicked => {
                            root.attach-files();
                            attach-menu.close();
                        }
                    }

                    MenuItem {
                        text: @tr("Add folder");
                        hint: @tr("All text files inside a folder");
                        clicked => {
                            root.attach-folder();
                            attach-menu.close();
                        }
                    }

                    MenuItem {
                        text: @tr("Add media");
                        hint: @tr("Images, video, audio (transcribed)");
                        clicked => {
                            root.attach-media();
                            attach-menu.close();
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }

                    MenuItem {
                        text: @tr("Give folder access");
                        hint: @tr("The model may read files there (tools)");
                        clicked => {
                            root.share-folder();
                            attach-menu.close();
                        }
                    }

                    MenuItem {
                        text: @tr("🧪 Test environment");
                        hint: @tr("Project copy the model may change and test");
                        clicked => {
                            root.test-env();
                            attach-menu.close();
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        height: 16px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            opacity: root.mic-status != "" || root.mic-recording || root.usage-text != "" ? 1.0 : 0.0;

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.mic-recording ? #cf222e : root.mic-status != "" ? #bf8700 : #3fb950;
        }

        Text {
            text: root.mic-status != "" ? root.mic-status : root.mic-recording ? @tr("Recording") : @tr("Working") + "  ·  " + root.usage-text;
            font-size: 11px;
            opacity: 0.7;
            vertical-alignment: center;
            overflow: elide;
        }
        }

        if root.show-context-bar && root.context-label != "": HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 0;

            if root.context-used >= 0.5 && !root.busy: Rectangle {
                width: compact-text.preferred-width + 10px;
                border-radius: 4px;
                background: compact-touch.has-hover ? #80808030 : transparent;

                compact-text := Text {
                    text: "🗜 " + @tr("Compress");
                    font-size: 10px;
                    opacity: 0.8;
                    vertical-alignment: center;
                }

                compact-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.compact-chat(); }
                }
            }

            Text {
                text: root.context-label + " " + @tr("tokens");
                font-size: 10px;
                opacity: 0.6;
                vertical-alignment: center;
            }

            Rectangle {
                width: 90px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: #80808040;

                Rectangle {
                    x: 0;
                    width: parent.width * max(0.03, min(1.0, root.context-used));
                    height: parent.height;
                    border-radius: 3px;
                    background: root.context-used >= 0.85 ? #cf222e : root.context-used >= 0.6 ? #d4a72c : #3fb950;
                }
            }
        }
    }
}
