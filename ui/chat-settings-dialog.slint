import { Button, CheckBox, LineEdit, Palette } from "std-widgets.slint";

export global ChatSettings {
    in-out property <bool> open;
    in-out property <string> chat-id;
    in-out property <string> title;
    in property <string> group;
    in property <string> folders;
    in property <string> memory;
    in property <bool> has-memory;
    in-out property <bool> sandbox;
    in property <string> sandbox-status;
    in property <string> error;
    callback show(string);
    callback save();
    callback open-memory();
}

component Info inherits VerticalLayout {
    in property <string> label;
    in property <string> text;

    spacing: 2px;

    Text {
        text: root.label;
        font-weight: 600;
    }

    Rectangle {
        height: value.preferred-height;

        value := Text {
            x: 0;
            y: 0;
            width: parent.width;
            text: root.text;
            font-size: 12px;
            wrap: word-wrap;
            opacity: 0.8;
        }
    }
}

export component ChatSettingsDialog inherits Rectangle {
    background: #000000a0;

    TouchArea {}

    Rectangle {
        width: min(560px, root.width - 40px);
        height: min(content.preferred-height, root.height - 40px);
        background: Palette.background;
        border-radius: 14px;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000080;

        content := VerticalLayout {
            padding: 20px;
            spacing: 12px;

            Text {
                text: @tr("Chat settings");
                font-size: 20px;
                font-weight: 800;
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: @tr("Name");
                    font-weight: 600;
                }

                LineEdit {
                    text <=> ChatSettings.title;
                    accepted => { ChatSettings.save(); }
                }
            }

            Info {
                label: @tr("Group");
                text: ChatSettings.group;
            }

            Info {
                label: @tr("Shared folders");
                text: ChatSettings.folders;
            }

            HorizontalLayout {
                spacing: 8px;

                Info {
                    horizontal-stretch: 1;
                    label: @tr("Memory (brain)");
                    text: ChatSettings.memory;
                }

                if ChatSettings.has-memory: VerticalLayout {
                    alignment: center;

                    Button {
                        text: @tr("Open");
                        clicked => { ChatSettings.open-memory(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: @tr("Sandbox");
                    font-weight: 600;
                }

                CheckBox {
                    text: @tr("🛡 Terminal commands may only write into the project folder");
                    checked <=> ChatSettings.sandbox;
                }

                Rectangle {
                    height: status.preferred-height;

                    status := Text {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        text: ChatSettings.sandbox-status;
                        font-size: 12px;
                        wrap: word-wrap;
                        opacity: 0.7;
                    }
                }
            }

            if ChatSettings.error != "": Text {
                text: ChatSettings.error;
                color: #cf222e;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: @tr("Cancel");
                    clicked => { ChatSettings.open = false; }
                }

                Button {
                    text: @tr("Save");
                    primary: true;
                    clicked => { ChatSettings.save(); }
                }
            }
        }
    }
}
