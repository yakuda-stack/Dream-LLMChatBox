export struct MessageSegment {
    is-code: bool,
    is-heading: bool,
    is-tool: bool,
    is-think: bool,
    is-bullet: bool,
    level: int,
    language: string,
    text: string,
}

export struct ChatMessage {
    is-user: bool,
    text: string,
    attachment-names: string,
    attachments-json: string,
    segments: [MessageSegment],
    status: string,
    info: string,
    undo-count: int,
}

