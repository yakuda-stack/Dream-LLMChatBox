import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { ChatList } from "chat-list.slint";
import { Automations } from "automations-page.slint";
import { Spot, Tutorial } from "hint.slint";
import { ChatEntry, GroupEntry } from "types.slint";
import { Segmented } from "segmented.slint";
import { Avatar } from "avatar.slint";

component MenuEntry inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.alternate-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        x: 10px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
    }
}

component ChatItem inherits Rectangle {
    in property <ChatEntry> entry;
    in property <bool> active;
    in property <bool> enabled;
    callback clicked();
    callback rename(string);
    callback delete();
    property <bool> editing: false;
    property <bool> ctrl-click: false;
    property <length> drag: 0px;
    property <length> menu-x;
    property <length> menu-y;
    property <int> steps: round(root.drag / 34px);

    height: 34px;
    border-radius: 6px;
    border-width: entry.selected ? 1px : 0px;
    border-color: Palette.accent-background;
    background: active ? Palette.selection-background : entry.selected ? Palette.alternate-background : touch.has-hover ? Palette.control-background : transparent;

    touch := TouchArea {
        y: handle.pressed ? root.drag : 0px;
        enabled: root.enabled;
        clicked => {
            if (root.ctrl-click) {
                root.ctrl-click = false;
            } else {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && event.modifiers.control) {
                root.ctrl-click = true;
                ChatList.select(entry.id);
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
        double-clicked => {
            title-input.text = entry.title;
            root.editing = true;
            title-input.focus();
            title-input.select-all();
        }

        HorizontalLayout {
            padding-left: 2px;
            padding-right: 4px;
            spacing: 2px;

            Rectangle {
                width: 14px;
                opacity: touch.has-hover || handle.pressed ? 0.7 : 0.0;

                handle := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: grab;
                    moved => { root.drag = self.mouse-y - self.pressed-y; }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            if (root.steps != 0) {
                                ChatList.move(entry.id, root.steps);
                            }
                            root.drag = 0px;
                        }
                    }
                }

                Text {
                    text: handle.pressed && root.steps != 0 ? (root.steps > 0 ? "↓" : "↑") : "⋮⋮";
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if entry.pinned: Text {
                text: "📌";
                font-size: 11px;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;

                Text {
                    width: parent.width;
                    height: parent.height;
                    visible: !root.editing;
                    text: entry.title;
                    vertical-alignment: center;
                    overflow: elide;
                    color: active ? Palette.selection-foreground : Palette.alternate-foreground;
                }

                title-input := TextInput {
                    width: parent.width;
                    height: parent.height;
                    visible: root.editing;
                    enabled: root.editing;
                    single-line: true;
                    vertical-alignment: center;
                    color: active ? Palette.selection-foreground : Palette.alternate-foreground;
                    accepted => {
                        root.editing = false;
                        root.rename(self.text);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.editing = false;
                            return accept;
                        }
                        return reject;
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.editing = false;
                        }
                    }
                }
            }

            Rectangle {
                width: 26px;
                opacity: touch.has-hover ? 1.0 : 0.0;

                delete-touch := TouchArea {
                    enabled: root.enabled && touch.has-hover;
                    clicked => { root.delete(); }
                }

                Text {
                    text: "×";
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: delete-touch.has-hover ? 1.0 : 0.6;
                }
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 230px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 4px;

                MenuEntry {
                    text: entry.pinned ? @tr("📌 Unpin") : @tr("📌 Pin to top");
                    clicked => {
                        ChatList.toggle-pin(entry.id);
                        menu.close();
                    }
                }

                MenuEntry {
                    text: @tr("↑ Move up");
                    clicked => {
                        ChatList.move(entry.id, -1);
                        menu.close();
                    }
                }

                MenuEntry {
                    text: @tr("↓ Move down");
                    clicked => {
                        ChatList.move(entry.id, 1);
                        menu.close();
                    }
                }

                MenuEntry {
                    text: entry.selected ? @tr("☑ Unselect") : @tr("☐ Select (Ctrl + click)");
                    clicked => {
                        ChatList.select(entry.id);
                        menu.close();
                    }
                }

                MenuEntry {
                    text: @tr("⤓ Export as Markdown…");
                    clicked => {
                        ChatList.export(entry.id);
                        menu.close();
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                Text {
                    x: 10px;
                    height: 24px;
                    text: @tr("Assign to group");
                    font-size: 11px;
                    opacity: 0.6;
                    vertical-alignment: center;
                }

                for name[index] in ChatList.group-names: MenuEntry {
                    text: "📁 " + name;
                    clicked => {
                        ChatList.assign(entry.id, ChatList.group-ids[index]);
                        menu.close();
                    }
                }

                MenuEntry {
                    text: @tr("— No group");
                    clicked => {
                        ChatList.assign(entry.id, "");
                        menu.close();
                    }
                }

                if ChatList.selection-count >= 2: VerticalLayout {
                    spacing: 4px;

                    Rectangle {
                        height: 1px;
                        background: Palette.border;
                    }

                    Text {
                        x: 10px;
                        height: 24px;
                        text: ChatList.selection-count + " " + @tr("selected – merge their memories");
                        font-size: 11px;
                        opacity: 0.6;
                        vertical-alignment: center;
                    }

                    merge-name := LineEdit {
                        placeholder-text: @tr("Name of the new group");
                    }

                    MenuEntry {
                        text: @tr("🧠 Merge into new group");
                        clicked => {
                            ChatList.merge(merge-name.text);
                            menu.close();
                        }
                    }

                    MenuEntry {
                        text: @tr("Clear selection");
                        clicked => {
                            ChatList.clear-selection();
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component GroupItem inherits VerticalLayout {
    in property <GroupEntry> group;
    property <bool> ctrl-click: false;
    in property <string> current-chat-id;
    in property <bool> enabled;
    callback toggle();
    callback load-chat(string);
    callback rename-chat(string, string);
    callback delete-chat(string);
    callback new-chat();
    callback settings();
    callback open-memory();
    callback export(bool);

    Rectangle {
        height: 30px;
        border-radius: 6px;
        background: root.group.selected ? Palette.alternate-background : header.has-hover ? Palette.control-background : transparent;
        border-width: root.group.selected ? 1px : 0px;
        border-color: Palette.accent-background;

        header := TouchArea {
            clicked => {
                if (root.ctrl-click) {
                    root.ctrl-click = false;
                } else {
                    root.toggle();
                }
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && event.modifiers.control) {
                    root.ctrl-click = true;
                    ChatList.select("group:" + root.group.id);
                }
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                    menu.show();
                }
            }
        }

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 6px;

            Text {
                width: 10px;
                text: root.group.collapsed ? "▸" : "▾";
                font-size: 12px;
                opacity: 0.7;
                vertical-alignment: center;
            }

            Text {
                text: "📁";
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: root.group.name;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Text {
                text: root.group.chats.length;
                font-size: 11px;
                opacity: 0.5;
                vertical-alignment: center;
            }

            Rectangle {
                width: 22px;

                more := TouchArea {
                    clicked => { menu.show(); }
                }

                Text {
                    text: "⋯";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: more.has-hover || header.has-hover ? 0.9 : 0.0;
                }
            }
        }

        menu := PopupWindow {
            x: 20px;
            y: parent.height;
            width: 210px;

            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;

                VerticalLayout {
                    padding: 6px;

                    MenuEntry {
                        text: @tr("New chat in this group");
                        clicked => {
                            root.new-chat();
                            menu.close();
                        }
                    }

                    MenuEntry {
                        text: root.group.selected ? @tr("☑ Unselect") : @tr("☐ Select (Ctrl + click)");
                        clicked => {
                            ChatList.select("group:" + root.group.id);
                            menu.close();
                        }
                    }

                    if ChatList.selection-count >= 2: VerticalLayout {
                        group-merge-name := LineEdit {
                            placeholder-text: @tr("Name of the new group");
                        }

                        MenuEntry {
                            text: @tr("🧠 Merge selected into new group");
                            clicked => {
                                ChatList.merge(group-merge-name.text);
                                menu.close();
                            }
                        }
                    }

                    MenuEntry {
                        text: @tr("Group settings…");
                        clicked => {
                            root.settings();
                            menu.close();
                        }
                    }

                    MenuEntry {
                        text: @tr("Open memory folder");
                        clicked => {
                            root.open-memory();
                            menu.close();
                        }
                    }

                    MenuEntry {
                        text: @tr("Export…");
                        clicked => {
                            root.export(false);
                            menu.close();
                        }
                    }

                    MenuEntry {
                        text: @tr("Export with chats…");
                        clicked => {
                            root.export(true);
                            menu.close();
                        }
                    }
                }
            }
        }
    }

    if !root.group.collapsed: VerticalLayout {
        padding-left: 14px;

        for entry in root.group.chats: ChatItem {
            entry: entry;
            active: entry.id == root.current-chat-id;
            enabled: root.enabled;
            clicked => { root.load-chat(entry.id); }
            rename(title) => { root.rename-chat(entry.id, title); }
            delete => { root.delete-chat(entry.id); }
        }

        if root.group.chats.length == 0: Text {
            height: 26px;
            text: @tr("No chats yet");
            font-size: 11px;
            opacity: 0.5;
            vertical-alignment: center;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ChatEntry]> chats;
    in property <string> current-chat-id;
    in property <bool> busy;
    in-out property <int> page;
    in property <int> chat-offset;
    in property <int> chat-total;
    in property <int> chat-page-size: 30;
    in-out property <bool> chats-open: true;
    in property <string> user-name;
    in property <string> app-version;
    in property <image> user-picture;
    in property <bool> has-user-picture;
    callback open-profiles();
    in property <bool> ollama-running;
    in property <bool> ollama-switching;
    callback new-chat();
    callback open-settings(int);
    callback ollama-toggle();
    in property <bool> ollama-installed: true;
    callback ollama-install();
    callback chat-page(int);
    callback load-chat(string);
    callback rename-chat(string, string);
    callback delete-chat(string);
    in property <[GroupEntry]> groups;
    in-out property <bool> groups-open: true;
    callback group-toggle(string);
    callback group-new-chat(string);
    callback group-settings(string);
    callback group-open-memory(string);
    callback group-export(string, bool);
    callback group-create();
    callback group-import();

    background: Palette.alternate-background;
    clip: true;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Spot {
            name: "tabs";

            Segmented {
                labels: [@tr("Chat"), @tr("Models")];
                current <=> root.page;
            }
        }

        Spot {
            name: "new-chat";

            Button {
                text: @tr("New chat");
                enabled: !root.busy;
                clicked => { root.new-chat(); }
            }
        }

        Spot {
            name: "search";

            LineEdit {
                placeholder-text: @tr("🔍 Search chats");
                text <=> ChatList.query;
                edited(text) => { ChatList.search(text); }
            }
        }

        Spot {
            name: "automations";

            automations-row := Rectangle {
                height: 30px;
                border-radius: 6px;
                background: automations-touch.has-hover || root.page == 5 ? Palette.control-background : transparent;

                automations-touch := TouchArea {
                    clicked => { root.page = root.page == 5 ? 0 : 5; }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        text: "⏰  " + @tr("Automations");
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if Automations.active-count > 0: Text {
                        text: Automations.active-count;
                        font-size: 11px;
                        opacity: 0.6;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if ChatList.query != "": found := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: found.visible-width;
                alignment: start;
                spacing: 4px;

                for entry in ChatList.results: ChatItem {
                    entry: entry;
                    active: entry.id == root.current-chat-id;
                    enabled: !root.busy;
                    clicked => { root.load-chat(entry.id); }
                    rename(title) => { root.rename-chat(entry.id, title); }
                    delete => { root.delete-chat(entry.id); }
                }

                if ChatList.results.length == 0: Text {
                    text: @tr("Nothing found");
                    opacity: 0.6;
                    font-size: 12px;
                }
            }
        }

        if ChatList.query == "": list := ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: list.visible-width;
                min-height: list.visible-height;
                alignment: start;
                spacing: 4px;

                Spot {
                    name: "groups";

                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;

                        groups-header := TouchArea {
                            clicked => { root.groups-open = !root.groups-open; }

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    width: 10px;
                                    text: root.groups-open ? "▾" : "▸";
                                    font-size: 12px;
                                    opacity: 0.7;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: @tr("Groups");
                                    font-size: 12px;
                                    opacity: groups-header.has-hover ? 1.0 : 0.7;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle {
                            width: 22px;
                            border-radius: 4px;
                            background: page-touch.has-hover || root.page == 4 ? Palette.control-background : transparent;

                            page-touch := TouchArea {
                                clicked => { root.page = root.page == 4 ? 0 : 4; }
                            }

                            Text {
                                text: "▦";
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 22px;
                            border-radius: 4px;
                            background: add-touch.has-hover ? Palette.control-background : transparent;

                            add-touch := TouchArea {
                                enabled: !root.busy;
                                clicked => { root.group-create(); }
                            }

                            Text {
                                text: "+";
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 22px;
                            border-radius: 4px;
                            background: import-touch.has-hover ? Palette.control-background : transparent;

                            import-touch := TouchArea {
                                enabled: !root.busy;
                                clicked => { root.group-import(); }
                            }

                            Text {
                                text: "⤓";
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.groups-open: VerticalLayout {
                    spacing: 2px;

                    for group in root.groups: GroupItem {
                        group: group;
                        current-chat-id: root.current-chat-id;
                        enabled: !root.busy;
                        toggle => { root.group-toggle(group.id); }
                        load-chat(id) => { root.load-chat(id); }
                        rename-chat(id, title) => { root.rename-chat(id, title); }
                        delete-chat(id) => { root.delete-chat(id); }
                        new-chat => { root.group-new-chat(group.id); }
                        settings => { root.group-settings(group.id); }
                        open-memory => { root.group-open-memory(group.id); }
                        export(with-chats) => { root.group-export(group.id, with-chats); }
                    }

                    if root.groups.length == 0: Text {
                        text: @tr("No groups yet – \"+\" creates one, e.g. one per project.");
                        font-size: 11px;
                        opacity: 0.55;
                        wrap: word-wrap;
                    }
                }

                chats-header := TouchArea {
                    height: 24px;
                    clicked => { root.chats-open = !root.chats-open; }

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            width: 10px;
                            text: root.chats-open ? "▾" : "▸";
                            font-size: 12px;
                            opacity: 0.7;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.groups.length > 0 ? @tr("Chats without group") : @tr("Chats");
                            font-size: 12px;
                            opacity: chats-header.has-hover ? 1.0 : 0.7;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        if root.chat-total > root.chat-page-size: Text {
                            text: (root.chat-offset + 1) + "–" + min(root.chat-offset + root.chat-page-size, root.chat-total) + " / " + root.chat-total;
                            font-size: 11px;
                            opacity: 0.6;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.chats-open && root.chat-offset > 0: HorizontalLayout {
                    spacing: 6px;

                    Button {
                        text: @tr("Newest chats");
                        enabled: !root.busy;
                        clicked => { root.chat-page(0); }
                    }

                    Button {
                        text: @tr("Newer chats");
                        enabled: !root.busy;
                        clicked => { root.chat-page(max(0, root.chat-offset - root.chat-page-size)); }
                    }
                }

                if root.chats-open: VerticalLayout {
                    for entry in root.chats: ChatItem {
                        entry: entry;
                        active: entry.id == root.current-chat-id;
                        enabled: !root.busy;
                        clicked => { root.load-chat(entry.id); }
                        rename(title) => { root.rename-chat(entry.id, title); }
                        delete => { root.delete-chat(entry.id); }
                    }
                }

                if root.chats-open && root.chat-offset + root.chat-page-size < root.chat-total: Button {
                    text: @tr("Older chats");
                    enabled: !root.busy;
                    clicked => { root.chat-page(root.chat-offset + root.chat-page-size); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        Spot {
            name: "ollama";

            HorizontalLayout {
                height: 32px;
                padding-left: 8px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.ollama-switching ? #bf8700 : root.ollama-running ? #2ea043 : #8b949e;
                    }
                }

                Text {
                    text: root.ollama-switching ? @tr("Ollama …") : root.ollama-running ? @tr("Ollama running") : !root.ollama-installed ? @tr("Ollama not installed") : @tr("Ollama stopped");
                    vertical-alignment: center;
                    font-size: 12px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if root.ollama-installed || root.ollama-running: Button {
                    text: root.ollama-running ? @tr("Stop") : @tr("Start");
                    enabled: !root.ollama-switching && !root.busy;
                    clicked => { root.ollama-toggle(); }
                }

                if !root.ollama-installed && !root.ollama-running: Button {
                    text: @tr("Install");
                    primary: true;
                    enabled: !root.ollama-switching;
                    clicked => { root.ollama-install(); }
                }
            }
        }

        Spot {
            name: "profile";

            profile-button := Rectangle {
                height: 44px;
                border-radius: 8px;
                background: profile-touch.has-hover ? Palette.control-background : transparent;

                profile-touch := TouchArea {
                    clicked => { profile-menu.show(); }
                }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;

                        Avatar {
                            size: 30px;
                            picture: root.user-picture;
                            has-picture: root.has-user-picture;
                        }
                    }

                    Text {
                        text: root.user-name;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "⋯";
                        vertical-alignment: center;
                        opacity: 0.6;
                    }
                }

                profile-menu := PopupWindow {
                    x: 0px;
                    y: -self.height - 6px;
                    width: 216px;

                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.border;
                        background: Palette.background;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000040;

                        VerticalLayout {
                            padding: 6px;

                            HorizontalLayout {
                                height: 28px;
                                padding-left: 10px;

                                Text {
                                    text: "Dream-LLMChatBox v" + root.app-version;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    opacity: 0.6;
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Palette.border;
                            }

                            for item[index] in [@tr("Profile"), @tr("Settings"), @tr("Ollama settings"), @tr("Tools"), @tr("Start arguments"), @tr("Switch profile…")]: Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: item-touch.has-hover ? Palette.alternate-background : transparent;

                                item-touch := TouchArea {
                                    clicked => {
                                        if (index == 3) {
                                            root.page = 2;
                                        } else if (index == 4) {
                                            root.page = 3;
                                        } else if (index == 5) {
                                            root.open-profiles();
                                        } else {
                                            root.open-settings(index == 0 ? 1 : index == 1 ? 3 : 2);
                                        }
                                        profile-menu.close();
                                    }
                                }

                                Text {
                                    x: 10px;
                                    height: parent.height;
                                    text: item;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
