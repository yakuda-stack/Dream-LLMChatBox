import { Button, Palette } from "std-widgets.slint";
import { ChatMessage, MessageSegment, VoiceEntry } from "types.slint";

component SmallIcon inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    in property <brush> tone: Palette.foreground;
    in property <brush> hover: Palette.alternate-background;
    callback clicked();
    callback right-clicked();

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: root.active ? Palette.accent-background : touch.has-hover ? root.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.right-clicked();
            }
        }
    }

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.active ? Palette.accent-foreground : root.tone;
        stroke-width: 2px;
        fill: transparent;
        opacity: 0.8;
    }

    if touch.has-hover && root.tooltip != "": Rectangle {
        x: 0px;
        y: parent.height + 4px;
        width: tip.preferred-width + 12px;
        height: 22px;
        border-radius: 4px;
        background: #000000cc;

        tip := Text {
            text: root.tooltip;
            color: white;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CodeBlock inherits Rectangle {
    in property <string> language;
    in property <string> code;
    property <bool> copied;

    border-radius: 8px;
    background: #1e1f22;
    clip: true;

    VerticalLayout {
        Rectangle {
            height: 30px;
            background: #2b2d31;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;

                Text {
                    text: root.language != "" ? root.language : "code";
                    color: #b5bac1;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: copy-label.preferred-width + 16px;
                    border-radius: 4px;
                    background: copy-touch.has-hover ? #3a3c42 : transparent;

                    copy-touch := TouchArea {
                        clicked => {
                            code-text.select-all();
                            code-text.copy();
                            code-text.clear-selection();
                            root.copied = true;
                            reset.running = true;
                        }
                    }

                    copy-label := Text {
                        text: root.copied ? @tr("Copied ✓") : @tr("Copy");
                        color: #dbdee1;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            padding: 12px;

            Rectangle {
                height: code-text.preferred-height;

                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Copy");
                            activated => { code-text.copy(); }
                        }

                        MenuItem {
                            title: @tr("Select all");
                            activated => { code-text.select-all(); }
                        }
                    }

                    code-text := TextInput {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        text: root.code;
                        read-only: true;
                        single-line: false;
                        wrap: word-wrap;
                        font-family: "monospace";
                        font-size: 13px;
                        color: #e6e6e6;
                    }
                }
            }
        }
    }

    reset := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }
}

component TypingDots inherits HorizontalLayout {
    in property <color> tone;

    height: 18px;
    spacing: 5px;
    alignment: start;

    for index in 3: Rectangle {
        width: 8px;
        height: 18px;

        Rectangle {
            property <float> phase: mod(animation-tick() / 1ms + 1200 - index * 160, 1200);

            x: 0;
            y: 10px - (self.phase < 600 ? sin(self.phase / 600 * 180deg) * 8px : 0px);
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.tone;
            opacity: self.phase < 600 ? 0.95 : 0.45;
        }
    }
}

component ThinkBox inherits Rectangle {
    in property <string> text;
    in property <string> title: "💭 " + @tr("Thinking");
    property <bool> open: false;

    background: Palette.control-background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    opacity: 0.85;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: (root.open ? "▾ " : "▸ ") + root.title;
                    font-size: 11px;
                    font-weight: 600;
                    opacity: 0.7;
                }

                if !root.open: Rectangle {
                    horizontal-stretch: 1;
                    height: 14px;
                    clip: true;

                    Text {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        text: root.text;
                        font-size: 11px;
                        opacity: 0.5;
                        overflow: elide;
                        vertical-alignment: top;
                    }
                }
            }
        }

        if root.open: Rectangle {
            height: think-text.preferred-height;

            ContextMenuArea {
                Menu {
                    MenuItem {
                        title: @tr("Copy");
                        activated => { think-text.copy(); }
                    }

                    MenuItem {
                        title: @tr("Select all");
                        activated => { think-text.select-all(); }
                    }
                }

                think-text := TextInput {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    text: root.text;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.control-foreground;
                }
            }
        }
    }
}

export component MessageBubble inherits VerticalLayout {
    in property <ChatMessage> message;
    in property <length> max-bubble-width;
    in property <bool> is-last;
    in property <bool> can-edit;
    in property <bool> busy;
    in property <bool> speaking;
    in property <string> user-name;
    in property <[VoiceEntry]> voices;
    callback speak();
    callback continue-reply();
    callback undo-changes();
    callback edit-prompt();
    callback voice-selected(string);
    callback voice-add-file();

    property <bool> copied;

    padding-left: 16px;
    padding-right: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    spacing: 4px;

    HorizontalLayout {
        alignment: message.is-user ? end : start;

        Rectangle {
            max-width: root.max-bubble-width;
            border-radius: 12px;
            background: message.is-user ? Palette.accent-background : Palette.alternate-background;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: message.is-user ? root.user-name : @tr("Assistant");
                        font-size: 11px;
                        font-weight: 600;
                        color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                        opacity: 0.7;
                    }

                    if message.is-user && message.info != "": Text {
                        text: message.info;
                        font-size: 11px;
                        color: Palette.accent-foreground;
                        opacity: 0.85;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }

                if message.attachment-names != "": Text {
                    text: @tr("Attached: ") + message.attachment-names;
                    font-size: 11px;
                    wrap: word-wrap;
                    color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                    opacity: 0.8;
                }

                if message.text == "" && message.attachment-names == "" && message.status == "stopped": Text {
                    text: @tr("(stopped)");
                    color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                    opacity: 0.7;
                }

                for segment in message.segments: VerticalLayout {
                    if segment.is-code: CodeBlock {
                        language: segment.language;
                        code: segment.text;
                    }

                    if segment.is-heading: Rectangle {
                        height: heading.preferred-height;
                        preferred-width: heading.preferred-width;

                        heading := Text {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            text: segment.text;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                            color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                        }
                    }

                    if segment.is-think: ThinkBox {
                        text: segment.text;
                        title: segment.language == "dream-compact" ? "🗜 " + @tr("Earlier messages summarized") : "💭 " + @tr("Thinking");
                    }

                    if segment.is-tool: Rectangle {
                        background: Palette.control-background;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 2px;

                            Text {
                                text: "🔧 " + @tr("Tool");
                                font-size: 11px;
                                font-weight: 600;
                                opacity: 0.6;
                                color: Palette.control-foreground;
                            }

                            Rectangle {
                                height: tool-text.preferred-height;
                        preferred-width: tool-text.preferred-width;

                                ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: @tr("Copy");
                                            activated => { tool-text.copy(); }
                                        }

                                        MenuItem {
                                            title: @tr("Select all");
                                            activated => { tool-text.select-all(); }
                                        }
                                    }

                                    tool-text := TextInput {
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        text: segment.text;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-family: "monospace";
                                        font-size: 12px;
                                        color: Palette.control-foreground;
                                        opacity: 0.85;
                                    }
                                }
                            }
                        }
                    }

                    if segment.is-bullet: HorizontalLayout {
                        padding-left: 4px + segment.level * 16px;
                        spacing: 6px;

                        Text {
                            text: segment.level == 0 ? "•" : "◦";
                            color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                            vertical-alignment: top;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: item.preferred-height;
                            preferred-width: item.preferred-width;

                            ContextMenuArea {
                                Menu {
                                    MenuItem {
                                        title: @tr("Copy");
                                        activated => { item.copy(); }
                                    }

                                    MenuItem {
                                        title: @tr("Select all");
                                        activated => { item.select-all(); }
                                    }
                                }

                                item := TextInput {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    text: segment.text;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                                }
                            }
                        }
                    }

                    if !segment.is-code && !segment.is-heading && !segment.is-tool && !segment.is-think && !segment.is-bullet: Rectangle {
                        height: body.preferred-height;
                        preferred-width: body.preferred-width;

                        ContextMenuArea {
                            Menu {
                                MenuItem {
                                    title: @tr("Copy");
                                    activated => { body.copy(); }
                                }

                                MenuItem {
                                    title: @tr("Select all");
                                    activated => { body.select-all(); }
                                }
                            }

                            body := TextInput {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                text: segment.text;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                color: message.is-user ? Palette.accent-foreground : Palette.alternate-foreground;
                            }
                        }
                    }
                }

                if message.is-user && root.can-edit && !root.busy: HorizontalLayout {
                    alignment: end;

                    SmallIcon {
                        icon: "M4 20h4L19 9l-4-4L4 16z M14 6l4 4";
                        tooltip: @tr("Edit and send again");
                        tone: Palette.accent-foreground;
                        hover: #ffffff33;
                        clicked => { root.edit-prompt(); }
                    }
                }

                if !message.is-user && root.is-last && root.busy: TypingDots {
                    tone: Palette.alternate-foreground;
                }

                if !message.is-user && (message.text != "" || message.status != ""): HorizontalLayout {
                    padding-top: 2px;
                    alignment: start;
                    spacing: 4px;

                    full-text := TextInput {
                        width: 0px;
                        height: 0px;
                        text: message.text;
                        read-only: true;
                        single-line: false;
                        opacity: 0;
                    }

                    if message.text != "": SmallIcon {
                        icon: root.speaking ? "M7 7h10v10H7z" : "M4 9v6h4l5 4V5L8 9H4z M16 9a4 4 0 0 1 0 6 M18.5 6.5a7.5 7.5 0 0 1 0 11";
                        tooltip: root.speaking ? @tr("Stop reading") : @tr("Read aloud (right-click: voice)");
                        active: root.speaking;
                        clicked => { root.speak(); }
                        right-clicked => { voice-menu.show(); }
                    }

                    if message.text != "": SmallIcon {
                        icon: root.copied ? "M5 12l5 5 9-11" : "M9 9h10v10H9z M5 15V5h10";
                        tooltip: root.copied ? @tr("Copied") : @tr("Copy text");
                        clicked => {
                            full-text.select-all();
                            full-text.copy();
                            full-text.clear-selection();
                            root.copied = true;
                            copy-reset.running = true;
                        }
                    }

                    if message.undo-count > 0 && !root.busy: Button {
                        text: "↶ " + @tr("Undo file changes") + " (" + message.undo-count + ")";
                        clicked => { root.undo-changes(); }
                    }

                    if root.is-last && !root.busy && message.status != "error" && message.text != "": SmallIcon {
                        icon: "M5 4l10 8-10 8z M19 5v14";
                        tooltip: @tr("Continue writing");
                        active: message.status == "limit" || message.status == "stopped";
                        clicked => { root.continue-reply(); }
                    }


                    if (message.status == "steps" || message.status == "pause" || message.status == "repeat") && root.is-last && !root.busy: Button {
                        text: @tr("▶ Continue");
                        primary: true;
                        clicked => { root.continue-reply(); }
                    }

                    if message.status == "repeat": Text {
                        text: @tr("Paused – the model repeated itself");
                        font-size: 11px;
                        opacity: 0.7;
                        vertical-alignment: center;
                    }

                    if message.status == "steps": Text {
                        text: @tr("Paused after many tool steps");
                        font-size: 11px;
                        opacity: 0.7;
                        vertical-alignment: center;
                    }

                    if message.status == "limit": Text {
                        text: @tr("Stopped near the context limit");
                        font-size: 11px;
                        opacity: 0.7;
                        vertical-alignment: center;
                    }

                    if message.info != "": Text {
                        text: message.info;
                        font-size: 11px;
                        opacity: 0.5;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    copy-reset := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }

    voice-menu := PopupWindow {
        x: 16px;
        y: root.height - 4px;
        width: 300px;

        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.background;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                Text {
                    text: @tr("Voice");
                    font-size: 11px;
                    opacity: 0.6;
                    height: 22px;
                    vertical-alignment: center;
                }

                for voice in root.voices: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: voice-touch.has-hover ? Palette.alternate-background : transparent;

                    voice-touch := TouchArea {
                        clicked => {
                            root.voice-selected(voice.id);
                            voice-menu.close();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            width: 14px;
                            text: voice.active ? "✓" : "";
                            vertical-alignment: center;
                        }

                        Text {
                            text: voice.label;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            opacity: voice.installed ? 1.0 : 0.75;
                        }

                        if !voice.installed: Text {
                            text: @tr("Download");
                            font-size: 11px;
                            color: Palette.accent-background;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: add-touch.has-hover ? Palette.alternate-background : transparent;

                    add-touch := TouchArea {
                        clicked => {
                            root.voice-add-file();
                            voice-menu.close();
                        }
                    }

                    Text {
                        x: 30px;
                        text: @tr("Add voice file (.onnx)…");
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
            }
        }
    }
}
