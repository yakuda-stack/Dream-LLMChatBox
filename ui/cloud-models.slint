import { Button, Palette, ScrollView, Switch } from "std-widgets.slint";

export struct CloudEntry {
    id: string,
    name: string,
    status: string,
    installed: bool,
    active: bool,
}

export global CloudModels {
    in property <[CloudEntry]> entries;
    in property <string> message;
    callback install(string);
    callback login(string);
    callback toggle(string, bool);
    callback refresh();
}

component CloudRow inherits Rectangle {
    in property <CloudEntry> entry;

    border-radius: 10px;
    border-width: 1px;
    border-color: entry.active ? Palette.accent-background : Palette.border;
    background: Palette.background;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding: 14px;
        spacing: 10px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;

            Text {
                text: "☁ " + entry.name;
                font-size: 15px;
                font-weight: 700;
            }

            Text {
                text: entry.status;
                font-size: 12px;
                opacity: 0.7;
                overflow: elide;
            }
        }

        if !entry.installed: Button {
            text: @tr("Install");
            primary: true;
            clicked => { CloudModels.install(entry.id); }
        }

        if entry.installed: Button {
            text: @tr("Log in");
            clicked => { CloudModels.login(entry.id); }
        }

        VerticalLayout {
            alignment: center;

            Switch {
                text: @tr("Active");
                enabled: entry.installed;
                checked: entry.active;
                toggled => { CloudModels.toggle(entry.id, self.checked); }
            }
        }
    }
}

export component CloudPage inherits ScrollView {
    VerticalLayout {
        padding: 12px;
        padding-top: 0px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            height: intro.preferred-height;

            intro := Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: @tr("Use the online AIs through their own command-line programs. 1. Install (opens a terminal, no sudo – it goes to ~/.local), 2. Log in once with your own account, 3. switch on “Active”. Active ones show up in the model list with ☁. They run on the provider's servers with your account, answer without the app's tools and see your shared folder through their own tools.");
                font-size: 12px;
                opacity: 0.75;
                wrap: word-wrap;
            }
        }

        for entry in CloudModels.entries: CloudRow {
            entry: entry;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 10px;

            Button {
                text: @tr("Check again");
                clicked => { CloudModels.refresh(); }
            }

            Text {
                text: CloudModels.message;
                font-size: 12px;
                opacity: 0.7;
                vertical-alignment: center;
            }
        }
    }
}
