    public function open-side(tab: int) {
        root.side-tab = tab;
        if (!root.side-open && root.width < 1200px) {
            root.sidebar-open = false;
        }
        root.side-open = true;
    }

    public function scroll-to-bottom() {
        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
    }

    VerticalLayout {
        Rectangle {
            height: 48px;
            background: Palette.alternate-background;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;

                    MenuToggle {
                        clicked => { root.sidebar-open = !root.sidebar-open; }
                    }
                }

                Image {
                    source: @image-url("../assets/icon.png");
                    width: 26px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "Dream-LLMChatBox";
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: Palette.border;
                    }
                }

                Text {
                    text: root.page == 1 ? @tr("Models") : root.page == 2 ? @tr("Tools") : root.page == 3 ? @tr("Start arguments") : root.page == 4 ? @tr("Groups") : root.page == 5 ? @tr("Automations") : (root.current-group-name != "" ? "📁 " + root.current-group-name + "  ›  " : "") + (root.current-chat-title != "" ? root.current-chat-title : @tr("New chat"));
                    vertical-alignment: center;
                    overflow: elide;
                    opacity: 0.8;
                    horizontal-stretch: 1;
                }

                if root.page == 0 && root.purpose-index == 1: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        height: 24px;
                        width: chip-text.preferred-width + 20px;
                        border-radius: 12px;
                        background: Palette.control-background;
                        border-width: 1px;
                        border-color: Palette.border;

                        chip-text := Text {
                            text: @tr("💻 Coding");
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.work-changes > 0: VerticalLayout {
                    alignment: center;

                    ActivityChip {
                        text: "📝 " + root.work-changes + " " + @tr("changes in work folder");
                        waiting: false;
                        dots: false;
                        clicked => { root.open-work-changes(); }
                    }
                }

                if root.activity-text != "" || root.approval-open || root.question-open: VerticalLayout {
                    alignment: center;

                    ActivityChip {
                        text: root.question-open ? @tr("Waiting for your answer") : root.approval-open ? @tr("Waiting for your OK") : root.activity-text;
                        waiting: root.approval-open || root.question-open;
                        clicked => { root.open-side(1); }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Spot {
                        name: "activity";

                        TopIcon {
                            icon: "M3 12h4l3-8 4 16 3-8h4";
                            tooltip: @tr("Activity & browser");
                            active: root.side-open && root.side-tab == 1;
                            clicked => {
                                if (root.side-open && root.side-tab == 1) {
                                    root.side-open = false;
                                } else {
                                    root.open-side(1);
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            Sidebar {
                width: root.sidebar-open ? 240px : 0px;
                animate width { duration: 150ms; easing: ease-out; }
                chats: root.chats;
                current-chat-id: root.current-chat-id;
                busy: root.busy;
                page <=> root.page;
                chat-offset: root.chat-offset;
                chat-total: root.chat-total;
                chat-page-size: root.chat-page-size;
                chat-page(offset) => { root.chat-page(offset); }
                new-chat => {
                    root.page = 0;
                    root.new-chat();
                }
                load-chat(id) => {
                    root.page = 0;
                    root.load-chat(id);
                }
                rename-chat(id, title) => { root.rename-chat(id, title); }
                delete-chat(id) => { root.delete-chat(id); }
                groups: root.groups;
                group-toggle(id) => { root.group-toggle(id); }
                group-new-chat(id) => {
                    root.page = 0;
                    root.group-new-chat(id);
                }
                group-settings(id) => { root.group-settings(id); }
                group-open-memory(id) => { root.group-open-memory(id); }
                group-export(id, with-chats) => { root.group-export(id, with-chats); }
                group-create => { root.group-create(); }
                group-import => { root.group-import(); }
                user-name: root.user-name;
                app-version: root.app-version;
                user-picture: root.profile-picture;
                has-user-picture: root.has-profile-picture;
                open-profiles => { root.open-profiles(); }
                ollama-running: root.ollama-running;
                ollama-switching: root.ollama-switching;
                ollama-toggle => { root.ollama-toggle(); }
                ollama-installed: root.ollama-installed;
                ollama-install => { root.ollama-install(); }
                open-settings(page) => { root.open-settings(page); }
            }

            VerticalLayout {
                if root.status != "": Rectangle {
                    height: status-text.preferred-height + 16px;
                    background: #a8323233;

                    status-text := Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: root.status;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;

                    Rectangle {
                        visible: root.page == 0;

                        VerticalLayout {
                            if root.messages.length == 0: HorizontalLayout {
                                padding: 12px;
                                padding-bottom: 0px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: @tr("Group:");
                                    vertical-alignment: center;
                                    opacity: 0.75;
                                }

                                Spot {
                                    name: "group";

                                    ComboBox {
                                        width: 240px;
                                        model: root.group-options;
                                        current-index <=> root.group-index;
                                        selected => { root.chat-group-selected(self.current-index); }
                                    }
                                }

                                Button {
                                    text: @tr("+ New group…");
                                    clicked => { root.group-create(); }
                                }

                                Text {
                                    text: @tr("Purpose:");
                                    vertical-alignment: center;
                                    opacity: 0.75;
                                }

                                Spot {
                                    name: "purpose";

                                    Segmented {
                                        width: 180px;
                                        labels: [@tr("Other"), @tr("Coding")];
                                        current <=> root.purpose-index;
                                        changed(index) => { root.purpose-selected(index); }
                                    }
                                }
                            }

                            if root.messages.length == 0: HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 6px;
                                spacing: 8px;
                                alignment: start;

                                Spot {
                                    name: "test-env";

                                    CheckBox {
                                        text: "🧪 " + @tr("Test environment");
                                        checked <=> root.test-env-on;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Hint {
                                        title: @tr("Test environment");
                                        text: @tr("The model works in its own folder instead of your real project: a copy of the shared project is made there when you send the first message. It may build, test and change everything inside. Your project stays untouched – take the changes over with “Apply to project”. The folder is deleted together with the chat.");
                                    }
                                }

                                Text {
                                    text: root.test-env-on ? @tr("On: the model works on a copy of your project, your files stay untouched.") : @tr("Off: the model works directly in the folders you share.");
                                    font-size: 12px;
                                    opacity: 0.65;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if root.messages.length == 0 && root.purpose-index == 1: VerticalLayout {
                                padding: 12px;
                                padding-bottom: 0px;
                                spacing: 6px;

                                Segmented {
                                    labels: [@tr("I have an ARCHITEKTUR.md"), @tr("No ARCHITEKTUR.md yet"), @tr("Brand new project")];
                                    current <=> root.coding-choice;
                                    changed(index) => { root.coding-choice-selected(index); }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    if root.coding-folder != "": Text {
                                        text: "📁 " + root.coding-folder;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }

                                    Text {
                                        text: root.coding-hint;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        opacity: 0.75;
                                        horizontal-stretch: 1;
                                    }

                                    if root.coding-folder == "": Button {
                                        text: @tr("Choose project folder…");
                                        clicked => { root.share-folder(); }
                                    }
                                }

                                if root.coding-warning != "": Text {
                                    text: "⚠ " + root.coding-warning;
                                    color: #d4a72c;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }

                            chat-list := ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    width: chat-list.visible-width;
                                    alignment: start;
                                    padding-bottom: 32px;

                                    for message[index] in root.messages: MessageBubble {
                                        max-bubble-width: chat-list.visible-width * 0.75;
                                        message: message;
                                        is-last: index == root.messages.length - 1;
                                        can-edit: message.is-user && index >= root.messages.length - 2;
                                        busy: root.busy;
                                        speaking: root.speaking-index == index;
                                        user-name: root.user-name;
                                        voices: root.voices;
                                        speak => { root.speak(index); }
                                        continue-reply => { root.continue-reply(); }
                                        undo-changes => { root.undo-changes(index); }
                                        edit-prompt => { root.edit-prompt(index); }
                                        voice-selected(id) => { root.voice-selected(id); }
                                        voice-add-file => { root.voice-add-file(); }
                                    }
                                }
                            }

                            if root.question-open: QuestionBar {
                                question: root.question-text;
                                options: root.question-options;
                                answer(text) => { root.question-answer(text); }
                            }

                            if root.approval-open: ApprovalBar {
                                command: root.approval-command;
                                folder: root.approval-folder;
                                title: root.approval-title;
                                warning: root.approval-warning;
                                answer(choice) => { root.approval-answer(choice); }
                            }

                            InputBar {
                                models: root.models;
                                selected-model <=> root.selected-model;
                                busy: root.busy;
                                usage-text: root.usage-text;
                                context-used: root.context-used;
                                think-mode <=> root.think-mode;
                                think-changed(mode) => { root.think-changed(mode); }
                                context-label: root.context-label;
                                show-context-bar: root.show-context-bar;
                                compact-chat => { root.compact-chat(); }
                                draft <=> root.draft;
                                kill-command: root.kill-command;
                                kill-in-terminal => { root.kill-in-terminal(); }
                                pending-attachments: root.pending-attachments;
                                mic-recording: root.mic-recording;
                                mic-busy: root.mic-busy;
                                mic-status: root.mic-status;
                                mic-level: root.mic-level;
                                mic-panel-open <=> root.mic-panel-open;
                                mic-devices: root.mic-devices;
                                mic-device-index <=> root.mic-device-index;
                                mic-languages: root.mic-languages;
                                mic-language-index <=> root.mic-language-index;
                                speech-models: root.speech-models;
                                speech-model-index <=> root.speech-model-index;
                                mic-gain <=> root.mic-gain;
                                mic-live <=> root.mic-live;
                                mic-live-changed(on) => { root.mic-live-changed(on); }
                                attach-files => { root.attach-files(); }
                                paste-clipboard => { return root.paste-clipboard(); }
                                attach-folder => { root.attach-folder(); }
                                attach-media => { root.attach-media(); }
                                remove-attachment(index) => { root.remove-attachment(index); }
                                shared-folders: root.shared-folders;
                                sync-available: root.sync-available;
                                auto-sync <=> root.auto-sync;
                                auto-sync-changed(on) => { root.auto-sync-changed(on); }
                                share-folder => { root.share-folder(); }
                                test-env => { root.test-env(); }
                                remove-shared-folder(index) => { root.remove-shared-folder(index); }
                                toggle-folder-write(index) => { root.toggle-folder-write(index); }
                                mic-toggle => { root.mic-toggle(); }
                                mic-panel(open) => { root.mic-panel(open); }
                                mic-device-selected(index) => { root.mic-device-selected(index); }
                                mic-language-selected(index) => { root.mic-language-selected(index); }
                                speech-model-selected(index) => { root.speech-model-selected(index); }
                                mic-gain-changed(gain) => { root.mic-gain-changed(gain); }
                                send(text) => { root.send(text); }
                                stop => { root.stop(); }
                                refresh-models => { root.refresh-models(); }
                                model-selected(model) => { root.model-changed(model); }
                            }
                        }
                    }

                    if root.page == 2: ToolsPage {
                        builtin-tools: root.builtin-tools;
                        custom-tools: root.custom-tools;
                        tools-enabled <=> root.tools-enabled;
                        form-open <=> root.tool-form-open;
                        form-error: root.tool-form-error;
                        form-old-name <=> root.tool-form-old-name;
                        form-builtin <=> root.tool-form-builtin;
                        form-name <=> root.tool-form-name;
                        form-description <=> root.tool-form-description;
                        form-params <=> root.tool-form-params;
                        form-command <=> root.tool-form-command;
                        tools-global(on) => { root.tools-global(on); }
                        tool-toggle(name, on) => { root.tool-toggle(name, on); }
                        tool-save(old, name, description, params, command) => { root.tool-save(old, name, description, params, command); }
                        tool-delete(name) => { root.tool-delete(name); }
                        tool-edit(name) => { root.tool-edit(name); }
                        tool-reset(name) => { root.tool-reset(name); }
                        tools-import => { root.tools-import(); }
                        tools-export => { root.tools-export(); }
                        tools-open-folder => { root.tools-open-folder(); }
                        safe-commands <=> root.safe-commands;
                        save-safe-commands(text) => { root.save-safe-commands(text); }
                        reset-safe-commands => { root.reset-safe-commands(); }
                        message: root.tools-message;
                    }

                    if root.page == 4: GroupsPage {
                        groups: root.groups;
                        open-group(id) => { root.group-settings(id); }
                        create => { root.group-create(); }
                        import => { root.group-import(); }
                        global-memory => { root.global-memory(); }
                    }

                    if root.page == 5: AutomationsPage {}

                    if root.page == 3: StartArgsPage {
                        entries: root.start-args;
                        arg-toggle(index, on) => { root.arg-toggle(index, on); }
                        arg-save(index, text) => { root.arg-save(index, text); }
                        arg-delete(index) => { root.arg-delete(index); }
                        arg-reset(index) => { root.arg-reset(index); }
                        arg-choose(index, choice) => { root.arg-choose(index, choice); }
                        arg-open-styles => { root.arg-open-styles(); }
                    }

                    if root.page == 1: ModelsPage {
                        installed: root.installed-models;
                        available-rows: root.available-rows;
                        available-detail: root.available-detail;
                        has-available-detail: root.has-available-detail;
                        available-message: root.available-message;
                        testing-model: root.testing-model;
                        chat-busy: root.busy;
                        hardware-text: root.hardware-text;
                        install(tag) => { root.install-model(tag); }
                        test(name) => { root.test-model(name); }
                        remove(name) => { root.remove-model(name); }
                        search(query) => { root.available-search(query); }
                        source-changed(index) => { root.available-source(index); }
                        category-changed(index) => { root.available-category(index); }
                        toggle-group(group) => { root.available-toggle-group(group); }
                        select(key) => { root.available-select(key); }
                        refresh => { root.refresh-models(); }
                    }
                }
            }

            if root.side-open: SidePanel {
                width: 360px;
                tab <=> root.side-tab;
                url: root.browser-url;
                title: root.browser-title;
                page-text: root.browser-text;
                links: root.browser-links;
                loading: root.browser-loading;
                error: root.browser-error;
                can-back: root.browser-can-back;
                by-model: root.browser-by-model;
                address <=> root.browser-address;
                activity: root.activity;
                go(text) => { root.browser-go(text); }
                back => { root.browser-back(); }
                open-external => { root.browser-external(); }
                open-link(url) => { root.browser-go(url); }
                clear-activity => { root.clear-activity(); }
                close => { root.side-open = false; }
            }
        }
    }

    if root.group-dialog-open: GroupDialog {
        width: root.width;
        height: root.height;
        is-new: root.group-dialog-new;
        name <=> root.group-dialog-name;
        folder: root.group-dialog-folder;
        folder-writable <=> root.group-dialog-writable;
        rules <=> root.group-dialog-rules;
        use-rules <=> root.group-dialog-use-rules;
        use-global <=> root.group-dialog-use-global;
        extra-args: root.group-dialog-extra-args;
        toggle-extra(index) => { root.group-dialog-toggle-extra(index); }
        removed-args: root.group-dialog-removed-args;
        toggle-removed(index) => { root.group-dialog-toggle-removed(index); }
        test-env <=> root.group-dialog-test-env;
        docs: root.group-dialog-docs;
        docs-status: root.group-dialog-docs-status;
        pick-docs => { root.group-dialog-pick-docs(); }
        clear-docs => { root.group-dialog-docs = ""; root.group-dialog-docs-status = ""; }
        index-docs => { root.group-dialog-index-docs(); }
        memory <=> root.group-dialog-memory;
        purpose <=> root.group-dialog-purpose;
        error: root.group-dialog-error;
        save => { root.group-dialog-save(); }
        cancel => { root.group-dialog-open = false; }
        pick-folder => { root.group-dialog-pick-folder(); }
        clear-folder => { root.group-dialog-folder = ""; }
        open-memory => { root.group-open-memory(""); }
        delete => { root.group-dialog-delete(); }
    }

    if root.settings-page > 0: SettingsDialog {
        width: root.width;
        height: root.height;
        page <=> root.settings-page;
        profile-name <=> root.profile-name;
        profile-about <=> root.profile-about;
        profile-picture: root.profile-picture;
        has-profile-picture: root.has-profile-picture;
        profile-initial: root.profile-initial;
        profile-can-delete: root.profile-count > 1;
        profile-message: root.profile-message;
        pick-picture => { root.profile-pick-picture(); }
        remove-picture => { root.profile-remove-picture(); }
        delete-profile => { root.profile-delete(); }
        ollama-url <=> root.ollama-url;
        context-index <=> root.context-index;
        keep-alive-index <=> root.keep-alive-index;
        system-prompt-text <=> root.system-prompt-text;
        context-options: root.context-options;
        keep-alive-options: root.keep-alive-options;
        language-options: root.language-options;
        language-index <=> root.language-index;
        tools-enabled <=> root.tools-enabled;
        show-context-bar <=> root.show-context-bar;
        auto-switch <=> root.auto-switch;
        auto-continue <=> root.auto-continue;
        auto-compact <=> root.auto-compact;
        compact-at <=> root.compact-at;
        work-dir <=> root.work-dir;
        container-index <=> root.container-index;
        container-image <=> root.container-image;
        container-status: root.container-status;
        container-changed(index) => { root.container-changed(index); }
        embed-model <=> root.embed-model;
        pick-work-dir => { root.pick-work-dir(); }
        save-general(index, tools) => { root.save-general(index, tools); }
        data-info: root.data-info;
        busy: root.busy;
        delete-all-chats => { root.delete-all-chats(); }
        open-reset => { root.open-reset(); }
        backend-index <=> root.backend-index;
        backend-status: root.backend-status;
        backend-busy: root.backend-busy;
        backend-apply(index) => { root.backend-apply(index); }
        ui-language-index <=> root.ui-language-index;
        theme-index <=> root.theme-index;
        theme-changed(index) => { root.theme-changed(index); }
        ui-language-changed(index) => { root.ui-language-changed(index); }
        start-tour => { root.start-tour(); }
        save-profile(name, about) => { root.save-profile(name, about); }
        save-ollama(url, context, keep, prompt) => { root.save-ollama(url, context, keep, prompt); }
    }

    if root.piper-dialog-open: Rectangle {
        background: #00000080;

        TouchArea { }

        Rectangle {
            width: min(520px, root.width - 40px);
            height: piper-card.preferred-height;
            border-radius: 14px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;

            piper-card := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: @tr("Read aloud needs Piper");
                    font-size: 18px;
                    font-weight: 700;
                }

                Text {
                    text: @tr("This command was copied to your clipboard. Run it in a terminal, or use another AUR helper:");
                    wrap: word-wrap;
                }

                Rectangle {
                    border-radius: 8px;
                    background: #1e1f22;

                    VerticalLayout {
                        padding: 10px;

                        piper-command-text := TextInput {
                            text: root.piper-command;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            font-family: "monospace";
                            color: #e6e6e6;
                            init => {
                                self.select-all();
                                self.copy();
                                self.clear-selection();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: @tr("OK");
                        clicked => { root.piper-dialog-open = false; }
                    }

                    Button {
                        text: @tr("Open terminal with this command");
                        primary: true;
                        clicked => {
                            root.install-piper(root.piper-command);
                            root.piper-dialog-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.profiles-open: ProfilesDialog {
        width: root.width;
        height: root.height;
        profiles: root.profiles;
        error: root.profiles-error;
        busy: root.busy;
        switch(id) => { root.switch-profile(id); }
        create(name) => { root.create-profile(name); }
        close => { root.profiles-open = false; }
    }

    if root.test-env-open: TestEnvDialog {
        width: root.width;
        height: root.height;
        text: root.test-env-text;
        accept => { root.test-env-accept(); }
        cancel => { root.test-env-open = false; }
    }

    if root.work-open: WorkDialog {
        width: root.width;
        height: root.height;
        diff: root.work-diff;
        count: root.work-changes;
        project: root.work-project;
        apply => { root.apply-work-changes(); }
        refresh => { root.open-work-changes(); }
        close => { root.work-open = false; }
    }

    if Tutorial.active: TourOverlay {
        width: root.width;
        height: root.height;
    }

    if root.reset-open: ResetDialog {
        width: root.width;
        height: root.height;
        folders: root.reset-folders;
        cancel => { root.reset-open = false; }
        confirm => { root.reset-all(); }
    }

    if root.unlock-open: UnlockScreen {
        width: root.width;
        height: root.height;
        profile-id: root.unlock-id;
        name: root.unlock-name;
        initial: root.unlock-initial;
        picture: root.unlock-picture;
        has-picture: root.unlock-has-picture;
        error: root.unlock-error;
        can-cancel: root.unlock-can-cancel;
        profiles: root.profiles;
        password <=> root.unlock-password;
        unlock(password) => { root.unlock-profile(password); }
        switch(id) => { root.switch-profile(id); }
        create(name) => { root.create-profile(name); }
        cancel => { root.unlock-open = false; }
    }
}
