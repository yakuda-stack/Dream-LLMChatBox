component MenuToggle inherits Rectangle {
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.control-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    for i in 3: Rectangle {
        x: 8px;
        y: 10px + i * 5px;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        background: Palette.foreground;
    }
}

component TopIcon inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: root.active ? Palette.accent-background : touch.has-hover ? Palette.control-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.active ? Palette.accent-foreground : Palette.foreground;
        stroke-width: 1.8px;
        fill: transparent;
    }

    if touch.has-hover && root.tooltip != "": Rectangle {
        x: parent.width - self.width;
        y: parent.height + 4px;
        width: tip.preferred-width + 12px;
        height: 22px;
        border-radius: 4px;
        background: #000000cc;

        tip := Text {
            text: root.tooltip;
            color: white;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ActivityChip inherits Rectangle {
    in property <string> text;
    in property <bool> waiting;
    in property <bool> dots: true;
    callback clicked();

    height: 28px;
    width: min(row.preferred-width, 360px);
    border-radius: 14px;
    background: root.waiting ? #d4a72c40 : touch.has-hover ? Palette.control-background : Palette.background;
    border-width: 1px;
    border-color: root.waiting ? #d4a72c : Palette.border;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;

        if root.dots: HorizontalLayout {
            spacing: 3px;
            alignment: center;

            for index in 3: Rectangle {
                width: 5px;

                Rectangle {
                    property <float> phase: mod(animation-tick() / 1ms + 1200 - index * 160, 1200);

                    x: 0;
                    y: (parent.height - 5px) / 2 + 2px - (self.phase < 600 ? sin(self.phase / 600 * 180deg) * 4px : 0px);
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.waiting ? #d4a72c : Palette.accent-background;
                }
            }
        }

        Text {
            text: root.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

