import { Button, Palette, ScrollView } from "std-widgets.slint";

export component WorkDialog inherits Rectangle {
    in property <string> diff;
    in property <int> count;
    in property <string> project;
    callback apply();
    callback refresh();
    callback close();

    background: #00000080;

    TouchArea { }

    Rectangle {
        width: min(parent.width - 40px, 900px);
        height: parent.height - 60px;
        background: Palette.background;
        border-radius: 12px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: @tr("Changes in the work folder");
                font-size: 17px;
                font-weight: 700;
            }

            Text {
                text: root.count == 0 ? @tr("No changes compared to the project.") : root.count + " " + @tr("changed files – “Apply” copies them into:") + " " + root.project;
                opacity: 0.7;
                overflow: elide;
            }

            view := ScrollView {
                vertical-stretch: 1;

                Rectangle {
                    width: max(view.visible-width, diff-text.preferred-width + 16px);
                    height: diff-text.preferred-height + 16px;

                    diff-text := TextInput {
                        x: 8px;
                        y: 8px;
                        text: root.diff;
                        read-only: true;
                        single-line: false;
                        font-family: "monospace";
                        font-size: 12px;
                        color: Palette.foreground;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: @tr("Refresh");
                    clicked => { root.refresh(); }
                }

                Button {
                    text: @tr("Close");
                    clicked => { root.close(); }
                }

                Button {
                    text: @tr("Apply to project");
                    primary: true;
                    enabled: root.count > 0;
                    clicked => { root.apply(); }
                }
            }
        }
    }
}

export component TestEnvDialog inherits Rectangle {
    in property <string> text;
    callback accept();
    callback cancel();

    background: #00000080;

    TouchArea { }

    Rectangle {
        width: min(parent.width - 40px, 560px);
        height: box.preferred-height;
        background: Palette.background;
        border-radius: 12px;
        border-width: 1px;
        border-color: Palette.border;

        box := VerticalLayout {
            padding: 18px;
            spacing: 12px;

            Text {
                text: @tr("🧪 Test environment for this chat");
                font-size: 17px;
                font-weight: 700;
            }

            Rectangle {
                height: info.preferred-height;

                info := Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    text: root.text;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }

                Button {
                    text: @tr("Accept");
                    primary: true;
                    clicked => { root.accept(); }
                }
            }
        }
    }
}
