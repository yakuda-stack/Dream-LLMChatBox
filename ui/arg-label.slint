import { Palette } from "std-widgets.slint";

export component ArgLabel inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    in property <bool> strike: false;
    property <bool> open: false;

    spacing: 4px;

    HorizontalLayout {
        spacing: 6px;

        Text {
            text: root.title;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
            opacity: root.strike ? 0.5 : 1.0;
        }

        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            border-width: 1px;
            border-color: info.has-hover || root.open ? Palette.accent-background : Palette.border;
            background: root.open ? Palette.accent-background : transparent;

            info := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }
            }

            Text {
                text: "i";
                font-size: 11px;
                font-weight: 700;
                font-italic: true;
                color: root.open ? Palette.accent-foreground : Palette.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }

    if root.open: Rectangle {
        height: full.preferred-height;

        full := Text {
            x: 0;
            y: 0;
            width: parent.width;
            text: root.text;
            font-size: 12px;
            opacity: 0.8;
            wrap: word-wrap;
        }
    }
}
